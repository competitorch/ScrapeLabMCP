{
  "type": "object",
  "properties": {
    "url": { "type": "string" },
    "slug": { "type": "string" },
    "tourName": { "type": "string" },
    "durationDays": { "type": "integer" },
    "ageRange": { "type": "string" },
    "totalDepartures": { "type": "integer" },
    "departures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "departureDate": { "type": "string", "format": "date" },
          "durationDays": { "type": "integer" },
          "departureCity": { "type": "string" },
          "coordinator": { "type": "string" },
          "price": { "type": "integer" },
          "deposit": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": ["available", "last_spots", "sold_out", "coming_soon"]
          },
          "spotsLeft": { "type": "integer" }
        },
        "required": ["departureDate", "price", "status"]
      }
    }
  }
}
